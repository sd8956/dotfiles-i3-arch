[global]
    # macOS-style notification cards: top-right, right under the bar
    follow = mouse
    origin = top-right
    offset = (12, 42)
    width = (300, 380)
    height = (0, 180)
    notification_limit = 5
    gap_size = 8

    # Card look (translucent: picom adds the blur behind it)
    background = "#1a1b26e6"
    foreground = "#c0caf5"
    frame_width = 1
    frame_color = "#414868"
    separator_color = frame
    corner_radius = 14
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12

    # Text: bold title, message below, app age after a minute
    font = "Adwaita Sans 11"
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    show_age_threshold = 60

    # App icons on the left, rounded like macOS
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 8
    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true

    # Progress bar (volume, downloads...)
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    highlight = "#7aa2f7"

    # Mouse: left runs the action and closes, middle clears all
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    foreground = "#a9b1d6"
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    # Stays until dismissed, with a red frame
    frame_color = "#f7768e"
    highlight = "#f7768e"
    timeout = 0
